    {
      "is_hidden": false,
      "name": {
        "es": "Efecto Espora",
        "en": "Effect Spore"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being paralyzed, poisoned, or put to sleep, chosen at random.\n\nNothing is done to compensate if the move's user is immune to one of these ailments; there is simply a lower chance that the move's user will be affected."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Piel Seca",
        "en": "Dry Skin"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "This Pokémon takes 1/8 of its maximum HP in damage after each turn during strong sunlight, but it heals for 1/8 of its HP each turn during rain.  This Pokémon takes 1.25× as much damage from Fire-type moves, but whenever a Water move hits it, it heals for 1/4 its maximum HP instead."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Humedad",
        "en": "Damp"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "While this Pokémon is in battle, Self-Destruct and Explosion will fail and Aftermath will not take effect."
      }
    }
