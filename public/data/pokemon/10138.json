    {
      "is_hidden": false,
      "name": {
        "es": "Escudo Limitado",
        "en": "Shields Down"
      },
      "description": {
        "es": "Rompe su coraza cuando sus PS se ven reducidos a la mitad y adopta una forma ofensiva.",
        "en": "When this Pokémon enters battle and at the end of each turn, if its HP is 50% or above, it changes into Meteor Form; otherwise, it changes into Core Form.  In Meteor Form, it cannot be given a major status ailment (though existing ones are not cured), cannot become drowsy from Yawn, and cannot use Rest (which will simply fail).\n\nThis ability cannot be copied, replaced, or nullified.  This ability only takes effect for Minior."
      }
    }
