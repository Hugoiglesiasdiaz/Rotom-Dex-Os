  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Imán",
        "en": "Magnet Pull"
      },
      "description": {
        "es": "Su magnetismo atrae a los Pokémon de tipo Acero y les impide huir.",
        "en": "While this Pokémon is in battle, opposing Steel-type Pokémon cannot flee or switch out. Pokémon with Run Away can still flee. Pokémon can still switch out with the use of a move or item. Overworld: If the lead Pokémon has this ability, Steel-type Pokémon have a higher encounter rate."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Robustez",
        "en": "Sturdy"
      },
      "description": {
        "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
        "en": "When this Pokémon is at full HP, any hit that would knock it out will instead leave it with 1 HP. Regardless of its current HP, it is also immune to the one-hit KO moves: Fissure, Guillotine, Horn Drill, and Sheer Cold. If this Pokémon is holding a Focus Sash, this ability takes precedence and the item will not be consumed."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Piel Eléctrica",
        "en": "Galvanize"
      },
      "description": {
        "es": "Convierte los movimientos de tipo Normal en tipo Eléctrico y aumenta ligeramente su potencia.",
        "en": "When this Pokémon uses a Normal moves, that move is Electric its power is 1.2×."
      }
    }
  ],
