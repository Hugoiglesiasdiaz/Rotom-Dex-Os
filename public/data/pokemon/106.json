  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Flexibilidad",
        "en": "Limber"
      },
      "description": {
        "es": "Evita ser paralizado gracias a la flexibilidad de su cuerpo.",
        "en": "This Pokémon cannot be paralyzed.\n\nIf a Pokémon is paralyzed and acquires this ability, its paralysis is healed; this includes when regaining a lost ability upon leaving battle."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Audaz",
        "en": "Reckless"
      },
      "description": {
        "es": "Potencia los movimientos que también dañan al usuario.",
        "en": "This Pokémon's recoil moves and crash moves have 1.2× their base power.\n\nStruggle is unaffected.\n\nThe \"crash moves\" are the moves that damage the user upon missing: Jump Kick and High Jump Kick."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Liviano",
        "en": "Unburden"
      },
      "description": {
        "es": "Sube su Velocidad si usa o pierde el objeto que lleva.",
        "en": "When this Pokémon uses or loses its held item, its Speed is doubled.  If it gains another item or leaves battle, this bonus is lost.\n\nThis includes when the Pokémon drops its item because of Knock Off.  This bonus does not count as a stat modifier.  There is no notification when this ability takes effect."
      }
    }
