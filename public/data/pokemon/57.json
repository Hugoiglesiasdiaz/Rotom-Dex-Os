    {
      "is_hidden": false,
      "name": {
        "es": "Espíritu Vital",
        "en": "Vital Spirit"
      },
      "description": {
        "es": "Su determinación le impide quedarse dormido.",
        "en": "This Pokémon cannot be asleep.\n\nThis causes Rest to fail altogether.  If a Pokémon is asleep and acquires this ability, it will immediately wake up; this includes when regaining a lost ability upon leaving battle.\n\nThis ability functions identically to Insomnia in battle.\n\nOverworld: If the lead Pokémon has this ability, higher-levelled Pokémon have their encounter rate increased."
      }
    },
    {
      "is_hidden": false,
