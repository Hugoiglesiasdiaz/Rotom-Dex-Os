  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Robustez",
        "en": "Sturdy"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "When this Pokémon is at full HP, any hit that would knock it out will instead leave it with 1 HP.  Regardless of its current HP, it is also immune to the one-hit KO moves: Fissure, Guillotine, Horn Drill, and Sheer Cold.\n\nIf this Pokémon is holding a Focus Sash, this ability takes precedence and the item will not be consumed."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Gula",
        "en": "Gluttony"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "This Pokémon eats any held Berry triggered by low HP when it falls below 50% of its HP, regardless of the Berry's usual threshold."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Respondón",
        "en": "Contrary"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "Whenever this Pokémon's stats would be raised, they are instead lowered by the same amount, and vice versa."
      }
    }
