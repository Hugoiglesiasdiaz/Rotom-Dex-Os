  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Cura Natural",
        "en": "Natural Cure"
      },
      "description": {
        "es": "Cura sus problemas de estado al cambiarse con otro Pokémon.",
        "en": "This Pokémon is cured of any major status ailment when it is switched out for another Pokémon. If this ability is acquired during battle, the Pokémon is cured upon leaving battle before losing the temporary ability."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Punto Tóxico",
        "en": "Poison Point"
      },
      "description": {
        "es": "Puede envenenar al mínimo contacto.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being poisoned."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Defensa Hoja",
        "en": "Leaf Guard"
      },
      "description": {
        "es": "Evita los problemas de estado si hace sol.",
        "en": "This Pokémon cannot be given a major status ailment during strong sunlight. This ability does not heal prior status ailments. Rest will fail altogether with this ability in effect. Yawn will immediately fail if used on this Pokémon during strong sunlight, and an already-used Yawn will fail if the weather turns to strong sunlight in the meantime."
      }
    }
