  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Robustez",
        "en": "Sturdy"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "When this Pokémon is at full HP, any hit that would knock it out will instead leave it with 1 HP.  Regardless of its current HP, it is also immune to the one-hit KO moves: Fissure, Guillotine, Horn Drill, and Sheer Cold.\n\nIf this Pokémon is holding a Focus Sash, this ability takes precedence and the item will not be consumed."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Velo Arena",
        "en": "Sand Veil"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "During a sandstorm, this Pokémon has 1.25× its evasion, and it does not take sandstorm damage regardless of type.\n\nThe evasion bonus does not count as a stat modifier.\n\nOverworld: If the lead Pokémon has this ability, the wild encounter rate is halved in a sandstorm."
      }
    }
  ],
