  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Robustez",
        "en": "Sturdy"
      },
      "description": {
        "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
        "en": "When this Pokémon is at full HP, any hit that would knock it out will instead leave it with 1 HP.  Regardless of its current HP, it is also immune to the one-hit KO moves: Fissure, Guillotine, Horn Drill, and Sheer Cold.\n\nIf this Pokémon is holding a Focus Sash, this ability takes precedence and the item will not be consumed."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Armadura Frágil",
        "en": "Weak Armor"
      },
      "description": {
        "es": "Al recibir daño de un ataque físico, le baja la Defensa, pero le sube mucho la Velocidad.",
        "en": "Whenever a physical move hits this Pokémon, its Speed rises one stage and its Defense falls one stage.\n\nThis ability triggers on every hit of a multiple-hit move."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Poder Arena",
        "en": "Sand Force"
      },
      "description": {
        "es": "Potencia los movimientos de tipo Tierra, Acero y Roca durante las tormentas de arena.",
        "en": "During a sandstorm, this Pokémon's Rock-, Ground-, and Steel-type moves have 1.3× their base power.  This Pokémon does not take sandstorm damage, regardless of type."
      }
    }
  ],
