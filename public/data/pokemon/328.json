  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Corte Fuerte",
        "en": "Hyper Cutter"
      },
      "description": {
        "es": "Evita que el rival le baje el Ataque.",
        "en": "This Pokémon's Attack cannot be lowered by other Pokémon.\n\nThis ability does not prevent any Attack losses other than stat modifiers, such as the Attack cut from a burn.  This Pokémon can still be passed negative Attack modifiers through Heart Swap or Power Swap."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Trampa Arena",
        "en": "Arena Trap"
      },
      "description": {
        "es": "Evita que el rival huya.",
        "en": "While this Pokémon is in battle, opposing Pokémon cannot flee or switch out.  Flying-type Pokémon and Pokémon in the air, e.g. due to Levitate or Magnet Rise, are unaffected.\n\nPokémon with Run Away can still flee.  Pokémon can still switch out with the use of a move or item.\n\nOverworld: If the lead Pokémon has this ability, the wild encounter rate is doubled."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Potencia Bruta",
        "en": "Sheer Force"
      },
      "description": {
        "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
        "en": "This Pokémon's moves with extra effects have 1.3× their power, but lose their extra effects.\n\nAn effect chance is a move's chance to inflict a status ailment, cause a stat change, or make the target flinch in addition to the move's main effect. For example, Thunder Shock's paralysis is an extra effect, but Thunder Wave's is not, nor are Knock Off's item removal and Air Cutter's increased critical hit rate.\n\nMoves that lower the user's stats are unaffected."
      }
    }
  ],
