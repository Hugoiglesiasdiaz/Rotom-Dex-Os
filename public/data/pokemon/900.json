  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Enjambre",
        "en": "Swarm"
      },
      "description": {
        "es": "Potencia sus movimientos de tipo Bicho cuando le quedan pocos PS.",
        "en": "When this Pokémon has 1/3 or less of its HP remaining, its Bug-type moves inflict 1.5× as much regular damage. Overworld: If the lead Pokémon has this ability, the wild encounter rate is increased."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Potencia Bruta",
        "en": "Sheer Force"
      },
      "description": {
        "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
        "en": "This Pokémon's moves with extra effects have 1.3× their power, but lose their extra effects. An effect chance is a move's chance to inflict a status ailment, cause a stat change, or make the target flinch in addition to the move's main effect. For example, Thunder Shock's paralysis is an extra effect, but Thunder Wave's is not, nor are Knock Off's item removal and Air Cutter's increased critical hit rate. Moves that lower the user's stats are unaffected."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Cortante",
        "en": "Sharpness"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "Increases the power of all 'slicing' moves by 50%."
      }
    }
