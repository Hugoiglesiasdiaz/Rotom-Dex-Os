  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Escudo Magma",
        "en": "Magma Armor"
      },
      "description": {
        "es": "Gracias al magma candente que lo envuelve, no puede ser congelado.",
        "en": "This Pokémon cannot be frozen.\n\nIf a Pokémon is frozen and acquires this ability, it will immediately thaw out; this includes when regaining a lost ability upon leaving battle.\n\nOverworld: If any Pokémon in the party has this ability, each egg in the party has its hatch counter decreased by 2 (rather than 1) each step cycle, making eggs hatch roughly twice as quickly.  This effect does not stack if multiple Pokémon have this ability or Flame Body."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Cuerpo Llama",
        "en": "Flame Body"
      },
      "description": {
        "es": "Puede quemar al mínimo contacto.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being burned.\n\nOverworld: If any Pokémon in the party has this ability, each egg in the party has its hatch counter decreased by 2 (rather than 1) each step cycle, making eggs hatch roughly twice as quickly.  This effect does not stack if multiple Pokémon have this ability or Magma Armor."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Armadura Frágil",
        "en": "Weak Armor"
      },
      "description": {
        "es": "Al recibir daño de un ataque físico, le baja la Defensa, pero le sube mucho la Velocidad.",
        "en": "Whenever a physical move hits this Pokémon, its Speed rises one stage and its Defense falls one stage.\n\nThis ability triggers on every hit of a multiple-hit move."
      }
    }
  ],
