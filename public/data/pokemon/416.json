  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Presión",
        "en": "Pressure"
      },
      "description": {
        "es": "Presiona al rival para que sus PP se acaben antes.",
        "en": "Moves targetting this Pokémon use one extra PP.\n\nThis ability stacks if multiple targets have it.  This ability still affects moves that fail or miss.  This ability does not affect ally moves that target either the entire field or just its side, nor this Pokémon's self-targetted moves; it does, however, affect single-targetted ally moves aimed at this Pokémon, ally moves that target all other Pokémon, and opponents' moves that target the entire field.  If this ability raises a move's PP cost above its remaining PP, it will use all remaining PP.\n\nWhen this Pokémon enters battle, all participating trainers are notified that it has this ability.\n\nOverworld: If the lead Pokémon has this ability, higher-levelled Pokémon have their encounter rate increased."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Nerviosismo",
        "en": "Unnerve"
      },
      "description": {
        "es": "Pone nervioso al rival y le impide usar bayas.",
        "en": "Opposing Pokémon cannot eat held Berries while this Pokémon is in battle.\n\nAffected Pokémon can still use Bug Bite or Pluck to eat a target's Berry."
      }
    }
  ],
