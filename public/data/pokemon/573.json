  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Gran Encanto",
        "en": "Cute Charm"
      },
      "description": {
        "es": "Puede causar enamoramiento al rival que lo toque.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being infatuated.\n\nOverworld: If the first Pokémon in the party has this ability, any wild Pokémon whose species can be either gender has a 2/3 chance of being set to the opposite gender, and a 1/3 chance of having a random gender as usual."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Experto",
        "en": "Technician"
      },
      "description": {
        "es": "Potencia sus movimientos más débiles.",
        "en": "This Pokémon's moves have 1.5× their power if their base power is 60 or less.\n\nThis includes moves of variable power, such as Hidden Power and Magnitude, when their power is 60 or less.  Helping Hand's power boost is taken into account for any move, as is Defense Curl's power boost for Rollout."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Encadenado",
        "en": "Skill Link"
      },
      "description": {
        "es": "Ejecuta siempre los movimientos múltiples con el número máximo de golpes.",
        "en": "This Pokémon always hits five times with two-to-five-hit moves, such as Icicle Spear.  It also bypasses the accuracy checks on Triple Kick's second and third hits."
      }
    }
