  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Electricidad Estática",
        "en": "Static"
      },
      "description": {
        "es": "La electricidad estática que lo envuelve puede paralizar al mínimo contacto.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being paralyzed. Pokémon that are immune to Electric-type moves can still be paralyzed by this ability. Overworld: If the lead Pokémon has this ability, there is a 50% chance that encounters will be with an Electric Pokémon, if applicable."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Espíritu Vital",
        "en": "Vital Spirit"
      },
      "description": {
        "es": "Su determinación le impide quedarse dormido.",
        "en": "This Pokémon cannot be asleep. This causes Rest to fail altogether. If a Pokémon is asleep and acquires this ability, it will immediately wake up; this includes when regaining a lost ability upon leaving battle. This ability functions identically to Insomnia in battle. Overworld: If the lead Pokémon has this ability, higher-levelled Pokémon have their encounter rate increased."
      }
    }
  ],
