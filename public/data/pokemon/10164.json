  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Gula",
        "en": "Gluttony"
      },
      "description": {
        "es": "Cuando sus PS se ven reducidos a la mitad, engulle la baya que normalmente solo se comería cuando le quedasen pocos PS.",
        "en": "This Pokémon eats any held Berry triggered by low HP when it falls below 50% of its HP, regardless of the Berry's usual threshold."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Ritmo Propio",
        "en": "Own Tempo"
      },
      "description": {
        "es": "Como le gusta hacer las cosas a su manera, los rivales no logran confundirlo.",
        "en": "This Pokémon cannot be confused. If a Pokémon is confused and acquires this ability, its confusion will immediately be healed."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Regeneración",
        "en": "Regenerator"
      },
      "description": {
        "es": "Recupera unos pocos PS al ser cambiado por otro Pokémon.",
        "en": "This Pokémon regains 1/3 of its maximum HP when it is switched out for another Pokémon under any circumstances other than having fainted. This ability does not take effect when a battle ends."
      }
    }
  ],
