  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Polvo Escudo",
        "en": "Shield Dust"
      },
      "description": {
        "es": "El polvo de escamas que lo envuelve lo protege de los efectos secundarios de los ataques recibidos.",
        "en": "This Pokémon is immune to the extra effects of moves used against it. An extra effect is a move's chance, listed as an \"effect chance\", to inflict a status ailment, cause a stat change, or make the target flinch in addition to the move's main effect. For example, Thunder Shock's paralysis is an extra effect, but Thunder Wave's is not, nor are Knock Off's item removal and Air Cutter's increased critical hit rate."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Ojo Compuesto",
        "en": "Compound Eyes"
      },
      "description": {
        "es": "Aumenta la precisión de sus movimientos.",
        "en": "This Pokémon's moves have 1.3× their accuracy. This ability has no effect on the one-hit KO moves (Fissure, Guillotine, Horn Drill, and Sheer Cold). Overworld: If the first Pokémon in the party has this ability, the chance of a wild Pokémon holding a particular item is raised from 50%, 5%, or 1% to 60%, 20%, or 5%, respectively."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Compiescolta",
        "en": "Friend Guard"
      },
      "description": {
        "es": "Reduce el daño que sufren los aliados.",
        "en": "All friendly Pokémon take 0.75× as much direct damage from moves while this Pokémon is in battle. This effect stacks if multiple allied Pokémon have it."
      }
    }
  ],
