  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Espíritu Vital",
        "en": "Vital Spirit"
      },
      "description": {
        "es": "Su determinación le impide quedarse dormido.",
        "en": "This Pokémon cannot be asleep. This causes Rest to fail altogether. If a Pokémon is asleep and acquires this ability, it will immediately wake up; this includes when regaining a lost ability upon leaving battle. This ability functions identically to Insomnia in battle. Overworld: If the lead Pokémon has this ability, higher-levelled Pokémon have their encounter rate increased."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Fuerza Mental",
        "en": "Inner Focus"
      },
      "description": {
        "es": "Gracias a su profunda concentración, no se amedrenta ante los ataques del rival.",
        "en": "This Pokémon cannot flinch."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Competitivo",
        "en": "Defiant"
      },
      "description": {
        "es": "Sube mucho su Ataque cuando el rival le baja las características.",
        "en": "When any of this Pokémon's stats are lowered, its Attack rises by two stages. If multiple stats are lowered at once, this ability takes effect with each stat lowered."
      }
    }
