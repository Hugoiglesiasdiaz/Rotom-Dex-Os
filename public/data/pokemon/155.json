    {
      "is_hidden": false,
      "name": {
        "es": "Mar Llamas",
        "en": "Blaze"
      },
      "description": {
        "es": "Potencia sus movimientos de tipo Fuego cuando le quedan pocos PS.",
        "en": "When this Pokémon has 1/3 or less of its HP remaining, its Fire-type moves inflict 1.5× as much regular damage."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Absorbe Fuego",
        "en": "Flash Fire"
      },
      "description": {
        "es": "Si le alcanza algún movimiento de tipo Fuego, potencia sus propios movimientos de dicho tipo.",
        "en": "This Pokémon is immune to Fire-type moves.  Once this Pokémon has been hit by a Fire move, its own Fire moves will inflict 1.5× as much damage until it leaves battle.\n\nThis ability has no effect while the Pokémon is frozen.  The Fire damage bonus is retained even if the Pokémon is frozen and thawed or the ability is lost or disabled.  Fire moves will ignore this Pokémon's Substitute.  This ability takes effect even on non-damaging moves, i.e. Will-O-Wisp."
      }
    }
