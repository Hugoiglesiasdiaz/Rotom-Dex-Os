  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Absorbe Electricidad",
        "en": "Volt Absorb"
      },
      "description": {
        "es": "Si le alcanza un movimiento de tipo Eléctrico, recupera PS en vez de sufrir daño.",
        "en": "Whenever an Electric-type move hits this Pokémon, it heals for 1/4 of its maximum HP, negating any other effect on it.\n\nThis ability will not take effect if this Pokémon is Ground-type and thus immune to Electric moves.  Electric moves will ignore this Pokémon's Substitute.\n\nThis effect includes non-damaging moves, i.e. Thunder Wave."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Cura Natural",
        "en": "Natural Cure"
      },
      "description": {
        "es": "Cura sus problemas de estado al cambiarse con otro Pokémon.",
        "en": "This Pokémon is cured of any major status ailment when it is switched out for another Pokémon.\n\nIf this ability is acquired during battle, the Pokémon is cured upon leaving battle before losing the temporary ability."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Puño Férreo",
        "en": "Iron Fist"
      },
      "description": {
        "es": "Aumenta la potencia de los puñetazos.",
        "en": "Moves flagged as being punch-based have 1.2× their base power for this Pokémon.\n\nSucker Punch is not flagged as punch-based; its original, Japanese name only means \"surprise attack\"."
      }
    }
  ],
