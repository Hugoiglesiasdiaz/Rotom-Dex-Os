  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Robustez",
        "en": "Sturdy"
      },
      "description": {
        "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
        "en": "When this Pokémon is at full HP, any hit that would knock it out will instead leave it with 1 HP. Regardless of its current HP, it is also immune to the one-hit KO moves: Fissure, Guillotine, Horn Drill, and Sheer Cold. If this Pokémon is holding a Focus Sash, this ability takes precedence and the item will not be consumed."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Caparazón",
        "en": "Shell Armor"
      },
      "description": {
        "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
        "en": "Moves cannot score critical hits against this Pokémon. This ability functions identically to Battle Armor."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Armadura Frágil",
        "en": "Weak Armor"
      },
      "description": {
        "es": "Al recibir daño de un ataque físico, le baja la Defensa, pero le sube mucho la Velocidad.",
        "en": "Whenever a physical move hits this Pokémon, its Speed rises one stage and its Defense falls one stage. This ability triggers on every hit of a multiple-hit move."
      }
    }
