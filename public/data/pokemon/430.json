  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Insomnio",
        "en": "Insomnia"
      },
      "description": {
        "es": "Su resistencia al sueño le impide quedarse dormido.",
        "en": "This Pokémon cannot be asleep. This causes Rest to fail altogether. If a Pokémon is asleep and acquires this ability, it will immediately wake up; this includes when regaining a lost ability upon leaving battle. This ability functions identically to Vital Spirit in battle."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Afortunado",
        "en": "Super Luck"
      },
      "description": {
        "es": "Su buena suerte aumenta la probabilidad de asestar golpes críticos.",
        "en": "This Pokémon's moves have critical hit rates one stage higher than normal."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Autoestima",
        "en": "Moxie"
      },
      "description": {
        "es": "Al debilitar a un objetivo, su confianza se refuerza de tal manera que aumenta su Ataque.",
        "en": "This Pokémon's Attack rises one stage upon knocking out another Pokémon, even a friendly Pokémon. This ability does not take effect when the Pokémon indirectly causes another Pokémon to faint, e.g. through poison or Spikes. If this Pokémon knocks out a Pokémon with Mummy, the former's ability will change without taking effect."
      }
    }
  ],
