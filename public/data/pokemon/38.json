  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Absorbe Fuego",
        "en": "Flash Fire"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "This Pokémon is immune to Fire-type moves.  Once this Pokémon has been hit by a Fire move, its own Fire moves will inflict 1.5× as much damage until it leaves battle.\n\nThis ability has no effect while the Pokémon is frozen.  The Fire damage bonus is retained even if the Pokémon is frozen and thawed or the ability is lost or disabled.  Fire moves will ignore this Pokémon's Substitute.  This ability takes effect even on non-damaging moves, i.e. Will-O-Wisp."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Sequía",
        "en": "Drought"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "The weather changes to strong sunlight when this Pokémon enters battle and does not end unless cancelled by another weather condition.\n\nIf multiple Pokémon with this ability, Drizzle, Sand Stream, or Snow Warning are sent out at the same time, the abilities will activate in order of Speed, respecting Trick Room.  Each ability's weather will cancel the previous weather, and only the weather summoned by the slowest of the Pokémon will stay."
      }
    }
  ],
