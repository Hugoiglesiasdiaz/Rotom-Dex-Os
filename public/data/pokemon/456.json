        "es": "Velo Agua",
        "en": "Water Veil"
      },
      "description": {
        "es": "Sin descripción disponible.",
        "en": "This Pokémon cannot be burned.\n\nIf a Pokémon is burned and acquires this ability, its burn is healed; this includes when regaining a lost ability upon leaving battle."
      }
    }
