  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Sebo",
        "en": "Thick Fat"
      },
      "description": {
        "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
        "en": "This Pokémon takes half as much damage from Fire- and Ice-type moves."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Agallas",
        "en": "Guts"
      },
      "description": {
        "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
        "en": "Whenever this Pokémon is asleep, burned, paralyzed, or poisoned, it has 1.5× its Attack.  This Pokémon is not affected by the usual Attack cut from a burn.\n\nThis bonus does not count as a stat modifier."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Potencia Bruta",
        "en": "Sheer Force"
      },
      "description": {
        "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
        "en": "This Pokémon's moves with extra effects have 1.3× their power, but lose their extra effects.\n\nAn effect chance is a move's chance to inflict a status ailment, cause a stat change, or make the target flinch in addition to the move's main effect. For example, Thunder Shock's paralysis is an extra effect, but Thunder Wave's is not, nor are Knock Off's item removal and Air Cutter's increased critical hit rate.\n\nMoves that lower the user's stats are unaffected."
      }
    }
  ],
