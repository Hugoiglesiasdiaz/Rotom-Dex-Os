  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Sincronía",
        "en": "Synchronize"
      },
      "description": {
        "es": "Contagia el envenenamiento, las quemaduras o la parálisis al Pokémon que le cause ese estado.",
        "en": "Whenever this Pokémon is burned, paralyzed, or poisoned, the Pokémon who gave this Pokémon that ailment is also given the ailment.\n\nThis ability passes back bad poison when this Pokémon is badly poisoned.  This ability cannot pass on a status ailment that the Pokémon did not directly receive from another Pokémon, such as the poison from Toxic Spikes or the burn from a Flame Orb.\n\nOverworld: If the lead Pokémon has this ability, wild Pokémon have a 50% chance of having the lead Pokémon's nature, and a 50% chance of being given a random nature as usual, including the lead Pokémon's nature.  This does not work on Pokémon received outside of battle or roaming legendaries."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Calco",
        "en": "Trace"
      },
      "description": {
        "es": "Al entrar en combate copia la habilidad del rival.",
        "en": "When this Pokémon enters battle, it copies a random opponent's ability.\n\nThis ability cannot copy Flower Gift, Forecast, Illusion, Imposter, Multitype, Trace, Wonder Guard, or Zen Mode."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Telepatía",
        "en": "Telepathy"
      },
      "description": {
        "es": "Elude los ataques de los aliados durante el combate.",
        "en": "This Pokémon does not take damage from friendly Pokémon's moves, including single-target moves aimed at it."
      }
    }
  ],
