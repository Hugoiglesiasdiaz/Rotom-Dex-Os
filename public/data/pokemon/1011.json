    {
      "is_hidden": false,
      "name": {
        "es": "Gula",
        "en": "Gluttony"
      },
      "description": {
        "es": "Cuando sus PS se ven reducidos a la mitad, engulle la baya que normalmente solo se comería cuando le quedasen pocos PS.",
        "en": "This Pokémon eats any held Berry triggered by low HP when it falls below 50% of its HP, regardless of the Berry's usual threshold."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Viscosidad",
        "en": "Sticky Hold"
      },
      "description": {
        "es": "Los objetos se quedan pegados a su cuerpo, por lo que no pueden robárselos.",
        "en": "This Pokémon's hold item cannot be removed by other Pokémon. Damaging moves that would remove this Pokémon's item can still inflict damage against this Pokémon, e.g. Knock Off or Pluck. This Pokémon can still use moves that involve the loss of its own item, e.g. Fling or Trick. Overworld: If the lead Pokémon has this ability, the encounter rate while fishing is increased."
      }
    }
