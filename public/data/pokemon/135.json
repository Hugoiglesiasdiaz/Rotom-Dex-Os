      "is_hidden": true,
      "name": {
        "es": "Pies Rápidos",
        "en": "Quick Feet"
      },
      "description": {
        "es": "Aumenta la Velocidad si sufre problemas de estado.",
        "en": "Whenever this Pokémon has a major status ailment, it has 1.5× its Speed. This Pokémon is not affected by the usual Speed cut from paralysis. Overworld: If the lead Pokémon has this ability, the wild encounter rate is halved."
      }
    }
