  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Espíritu Vital",
        "en": "Vital Spirit"
      },
      "description": {
        "es": "Su determinación le impide quedarse dormido.",
        "en": "This Pokémon cannot be asleep. This causes Rest to fail altogether. If a Pokémon is asleep and acquires this ability, it will immediately wake up; this includes when regaining a lost ability upon leaving battle. This ability functions identically to Insomnia in battle. Overworld: If the lead Pokémon has this ability, higher-levelled Pokémon have their encounter rate increased."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Antibarrera",
        "en": "Screen Cleaner"
      },
      "description": {
        "es": "Anula los efectos de Pantalla de Luz, Reflejo y Velo Aurora tanto de rivales como de aliados al entrar en combate.",
        "en": "When the Pokémon enters a battle, the effects of Light Screen, Reflect, and Aurora Veil are nullified for both opposing and ally Pokémon."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Gélido",
        "en": "Ice Body"
      },
      "description": {
        "es": "Recupera PS de forma gradual cuando hay tormentas de granizo.",
        "en": "This Pokémon heals for 1/16 of its maximum HP after each turn during hail, and it does not take hail damage regardless of type."
      }
    }
  ],
