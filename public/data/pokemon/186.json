  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Absorbe Agua",
        "en": "Water Absorb"
      },
      "description": {
        "es": "Si le alcanza un movimiento de tipo Agua, recupera PS en vez de sufrir daño.",
        "en": "Whenever a Water-type move hits this Pokémon, it heals for 1/4 of its maximum HP, negating any other effect on it.\n\nWater moves will ignore this Pokémon's Substitute."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Humedad",
        "en": "Damp"
      },
      "description": {
        "es": "Aumenta la humedad del entorno y evita que se puedan utilizar movimientos explosivos, tales como Autodestrucción.",
        "en": "While this Pokémon is in battle, Self-Destruct and Explosion will fail and Aftermath will not take effect."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Llovizna",
        "en": "Drizzle"
      },
      "description": {
        "es": "Hace que llueva al entrar en combate.",
        "en": "The weather changes to rain when this Pokémon enters battle and does not end unless replaced by another weather condition.\n\nIf multiple Pokémon with this ability, Drought, Sand Stream, or Snow Warning are sent out at the same time, the abilities will activate in order of Speed, respecting Trick Room.  Each ability's weather will cancel the previous weather, and only the weather summoned by the slowest of the Pokémon will stay."
      }
    }
  ],
