  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Electricidad Estática",
        "en": "Static"
      },
      "description": {
        "es": "La electricidad estática que lo envuelve puede paralizar al mínimo contacto.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being paralyzed. Pokémon that are immune to Electric-type moves can still be paralyzed by this ability. Overworld: If the lead Pokémon has this ability, there is a 50% chance that encounters will be with an Electric Pokémon, if applicable."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Flexibilidad",
        "en": "Limber"
      },
      "description": {
        "es": "Evita ser paralizado gracias a la flexibilidad de su cuerpo.",
        "en": "This Pokémon cannot be paralyzed. If a Pokémon is paralyzed and acquires this ability, its paralysis is healed; this includes when regaining a lost ability upon leaving battle."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Velo Arena",
        "en": "Sand Veil"
      },
      "description": {
        "es": "Aumenta su Evasión durante las tormentas de arena.",
        "en": "During a sandstorm, this Pokémon has 1.25× its evasion, and it does not take sandstorm damage regardless of type. The evasion bonus does not count as a stat modifier. Overworld: If the lead Pokémon has this ability, the wild encounter rate is halved in a sandstorm."
      }
    }
  ],
