  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Absorbe Electricidad",
        "en": "Volt Absorb"
      },
      "description": {
        "es": "Si le alcanza un movimiento de tipo Eléctrico, recupera PS en vez de sufrir daño.",
        "en": "Whenever an Electric-type move hits this Pokémon, it heals for 1/4 of its maximum HP, negating any other effect on it.\n\nThis ability will not take effect if this Pokémon is Ground-type and thus immune to Electric moves.  Electric moves will ignore this Pokémon's Substitute.\n\nThis effect includes non-damaging moves, i.e. Thunder Wave."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Iluminación",
        "en": "Illuminate"
      },
      "description": {
        "es": "Aumenta la probabilidad de encontrar Pokémon al iluminar el entorno.",
        "en": "Overworld: If the lead Pokémon has this ability, the wild encounter rate is doubled.\n\nThis ability has no effect in battle."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Absorbe Agua",
        "en": "Water Absorb"
      },
      "description": {
        "es": "Si le alcanza un movimiento de tipo Agua, recupera PS en vez de sufrir daño.",
        "en": "Whenever a Water-type move hits this Pokémon, it heals for 1/4 of its maximum HP, negating any other effect on it.\n\nWater moves will ignore this Pokémon's Substitute."
      }
    }
