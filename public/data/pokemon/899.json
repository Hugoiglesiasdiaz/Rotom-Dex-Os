  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Intimidación",
        "en": "Intimidate"
      },
      "description": {
        "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
        "en": "When this Pokémon enters battle, the opponent's Attack is lowered by one stage. In a double battle, both opponents are affected. This ability also takes effect when acquired during a battle, but will not take effect again if lost and reobtained without leaving battle. This ability has no effect on an opponent that has a Substitute. Overworld: If the first Pokémon in the party has this ability, any random encounter with a Pokémon five or more levels lower than it has a 50% chance of being skipped."
      }
    },
    {
      "is_hidden": false,
      "name": {
        "es": "Cacheo",
        "en": "Frisk"
      },
      "description": {
        "es": "Puede ver el objeto que lleva el rival al entrar en combate.",
        "en": "When this Pokémon enters battle, it reveals an opposing Pokémon's held item to all participating trainers. In a double battle, if one opponent has an item, this Pokémon will Frisk that Pokémon; if both have an item, it will Frisk one at random."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Herbívoro",
        "en": "Sap Sipper"
      },
      "description": {
        "es": "Neutraliza los movimientos de tipo Planta y sube su Ataque.",
        "en": "Whenever a Grass-type move hits this Pokémon, its Attack rises one stage, negating any other effect on it."
      }
    }
