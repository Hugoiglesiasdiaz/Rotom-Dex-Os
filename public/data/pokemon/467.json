      "name": {
        "es": "Cuerpo Llama",
        "en": "Flame Body"
      },
      "description": {
        "es": "Puede quemar al mínimo contacto.",
        "en": "Whenever a move makes contact with this Pokémon, the move's user has a 30% chance of being burned. Overworld: If any Pokémon in the party has this ability, each egg in the party has its hatch counter decreased by 2 (rather than 1) each step cycle, making eggs hatch roughly twice as quickly. This effect does not stack if multiple Pokémon have this ability or Magma Armor."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Espíritu Vital",
        "en": "Vital Spirit"
      },
      "description": {
        "es": "Su determinación le impide quedarse dormido.",
        "en": "This Pokémon cannot be asleep. This causes Rest to fail altogether. If a Pokémon is asleep and acquires this ability, it will immediately wake up; this includes when regaining a lost ability upon leaving battle. This ability functions identically to Insomnia in battle. Overworld: If the lead Pokémon has this ability, higher-levelled Pokémon have their encounter rate increased."
      }
    }
