  "abilities": [
    {
      "is_hidden": false,
      "name": {
        "es": "Robustez",
        "en": "Sturdy"
      },
      "description": {
        "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
        "en": "When this Pokémon is at full HP, any hit that would knock it out will instead leave it with 1 HP.  Regardless of its current HP, it is also immune to the one-hit KO moves: Fissure, Guillotine, Horn Drill, and Sheer Cold.\n\nIf this Pokémon is holding a Focus Sash, this ability takes precedence and the item will not be consumed."
      }
    },
    {
      "is_hidden": true,
      "name": {
        "es": "Insonorizar",
        "en": "Soundproof"
      },
      "description": {
        "es": "Su aislamiento acústico lo protege de movimientos que usan sonido.",
        "en": "This Pokémon is immune to moves flagged as being sound-based.\n\nHeal Bell is unaffected.  Uproar still prevents this Pokémon from sleeping.  This Pokémon can still receive a Perish Song counter through Baton Pass, and will retain a Perish Song counter if it acquires this ability after Perish Song is used.\n\nHowl, Roar of Time, Sonic Boom, and Yawn are not flagged as sound-based."
      }
    }
  ],
